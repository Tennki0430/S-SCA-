# note 入稿 + 競合分析用の環境変数サンプル
# ─────────────────────────────────────────────────────────
# 使い方:
#   cp .env.local.example .env.local
#   .env.local を開いて各値を埋める
#   .env.local は .gitignore に含まれているので git 管理外

# ── note.com ログイン認証 ──────────────────────────────
NOTE_EMAIL=your-note-account@example.com
NOTE_PASSWORD=your-note-password

# ── Jina AI ───────────────────────────────────────────
# 競合分析 (上位記事の全文取得) + ファクトチェック (公式ソース突合) に使用
# 取得先: https://jina.ai/api-dashboard/
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Gemini ──────────────────────────────────────
# サムネイル + 図解画像生成。必ず gemini-3.1-flash-image-preview を使用
# 取得先: https://aistudio.google.com/
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Discord 通知 (S-SCA の既存 Webhook を再利用可) ────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...
